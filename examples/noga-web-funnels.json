    "document_lifecycle_cross_feature": {
      "label": "Cross-feature — Document lifecycle",
      "priority": "high_value",
      "funnel_steps": [
        {
          "name": "Document list",
          "filter_expression": {
            "and_group": {
              "expressions": [
                { "funnel_event_filter": { "event_name": "page_view" } },
                {
                  "funnel_field_filter": {
                    "field_name": "pagePath",
                    "string_filter": {
                      "match_type": 1,
                      "value": "/document",
                      "case_sensitive": false
                    }
                  }
                }
              ]
            }
          }
        },
        {
          "name": "Send page",
          "filter_expression": {
            "and_group": {
              "expressions": [
                { "funnel_event_filter": { "event_name": "page_view" } },
                {
                  "funnel_field_filter": {
                    "field_name": "pagePath",
                    "string_filter": {
                      "match_type": 1,
                      "value": "/document/send",
                      "case_sensitive": false
                    }
                  }
                }
              ]
            }
          }
        },
        { "name": "Document sent", "event": "document_sent" },
        {
          "name": "Revisit document detail",
          "filter_expression": {
            "and_group": {
              "expressions": [
                { "funnel_event_filter": { "event_name": "page_view" } },
                {
                  "funnel_field_filter": {
