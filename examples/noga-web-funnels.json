{
  "_meta": {
    "description": "Noga Web funnel definitions for analytics-mcp run_funnel_report",
    "property_id": "535285702",
    "default_date_range": [
      {
        "start_date": "30daysAgo",
        "end_date": "yesterday",
        "name": "Last30Days"
      }
    ],
    "match_types": {
      "EXACT": 1,
      "BEGINS_WITH": 2,
      "ENDS_WITH": 3,
      "CONTAINS": 4,
      "FULL_REGEXP": 5
    },
    "notes": [
      "analytics-mcp runs these via run_funnel_report — it does not save funnels in GA4 UI.",
      "URL-only funnels miss wizard progress on /aml/create and /document/send — prefer event funnels there.",
      "Replace property_id before running."
    ]
  },
  "funnels": {
    "aml_url_list_create_view_edit": {
      "label": "AML — URL funnel (list → create → view → edit)",
      "priority": "secondary",
      "funnel_steps": [
        {
          "name": "AML list",
          "filter_expression": {
            "and_group": {
              "expressions": [
                { "funnel_event_filter": { "event_name": "page_view" } },
                {
                  "funnel_field_filter": {
                    "field_name": "pagePath",
                    "string_filter": {
                      "match_type": 1,
                      "value": "/aml",
                      "case_sensitive": false
                    }
                  }
                }
              ]
            }
          }
        },
        {
          "name": "Start create",
          "filter_expression": {
            "and_group": {
              "expressions": [
                { "funnel_event_filter": { "event_name": "page_view" } },
                {
                  "funnel_field_filter": {
                    "field_name": "pagePath",
                    "string_filter": {
                      "match_type": 1,
                      "value": "/aml/create",
                      "case_sensitive": false
                    }
                  }
                }
              ]
            }
          }
        },
        {
          "name": "View request",
          "filter_expression": {
            "and_group": {
              "expressions": [
                { "funnel_event_filter": { "event_name": "page_view" } },
                {
                  "funnel_field_filter": {
                    "field_name": "pagePath",
                    "string_filter": {
                      "match_type": 5,
                      "value": "^/aml/[^/]+$",
                      "case_sensitive": false
                    }
                  }
                }
              ]
            }
          }
        },
        {
          "name": "Edit request",
          "filter_expression": {
            "and_group": {
              "expressions": [
                { "funnel_event_filter": { "event_name": "page_view" } },
                {
                  "funnel_field_filter": {
                    "field_name": "pagePath",
                    "string_filter": {
                      "match_type": 5,
                      "value": "^/aml/[^/]+/edit$",
                      "case_sensitive": false
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "aml_event_create_wizard": {
      "label": "AML — Event funnel: create wizard (recommended)",
      "priority": "primary",
      "funnel_steps": [
        { "name": "AML list viewed", "event": "aml_list_viewed" },
        { "name": "Create started", "event": "aml_create_started" },
        {
          "name": "Step 1 — type selected",
          "filter_expression": {
            "funnel_event_filter": {
              "event_name": "aml_create_step_completed",
              "funnel_parameter_filter_expression": {
                "funnel_parameter_filter": {
                  "event_parameter_name": "step",
                  "numeric_filter": {
                    "operation": 1,
                    "value": { "int64_value": "1" }
                  }
                }
              }
            }
          }
        },
        {
          "name": "Step 2 — property/contact",
          "filter_expression": {
            "funnel_event_filter": {
              "event_name": "aml_create_step_completed",
              "funnel_parameter_filter_expression": {
                "funnel_parameter_filter": {
                  "event_parameter_name": "step",
                  "numeric_filter": {
                    "operation": 1,
                    "value": { "int64_value": "2" }
                  }
                }
              }
            }
          }
        },
        {
          "name": "Step 3 — details",
          "filter_expression": {
            "funnel_event_filter": {
              "event_name": "aml_create_step_completed",
              "funnel_parameter_filter_expression": {
                "funnel_parameter_filter": {
                  "event_parameter_name": "step",
                  "numeric_filter": {
                    "operation": 1,
                    "value": { "int64_value": "3" }
                  }
                }
              }
            }
          }
        },
        {
          "name": "Request submitted (not draft)",
          "filter_expression": {
            "funnel_event_filter": {
              "event_name": "aml_request_submitted",
              "funnel_parameter_filter_expression": {
                "funnel_parameter_filter": {
                  "event_parameter_name": "is_draft",
                  "string_filter": {
                    "match_type": 1,
                    "value": "false",
                    "case_sensitive": false
                  }
                }
              }
            }
          }
        },
        { "name": "Status viewed", "event": "aml_status_viewed" }
      ]
    },
